# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/bondbox
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bondbox?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/bondbox

# Optional: Dedicated Payment Collection / Table Name in MongoDB
# In development defaults to: payments_dev
# In production (NODE_ENV=production) defaults to: payments_production
PAYMENT_COLLECTION=payments_production

# JWT Authentication Secret Key
JWT_SECRET=bondbox_super_secret_jwt_key_2026

# Cloudinary Credentials (for photo/video/audio uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_KEY=your_cloudinary_api_key
CLOUD_SECRET=your_cloudinary_api_secret
